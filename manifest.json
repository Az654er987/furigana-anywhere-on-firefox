{
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup.html",
    "default_title": "Study Player Anywhere"
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "service_worker": "background.js"
  },
  "description": "Adds furigana, clickable word lookup, line replay, and a study transcript on top of Japanese subtitles on almost any web video player. Load your own .srt/.vtt if a site hides its captions.",
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "manifest_version": 3,
  "name": "Study Player Anywhere",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "version": "2.7.1",
  "web_accessible_resources": [
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "dict/*",
        "lib/kuromoji.js"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "{79e55574-d9ee-4c95-b2b6-ec3c61f9fe63}",
      "strict_min_version": "140.0",
      "update_url": "https://raw.githubusercontent.com/Az654er987/furigana-anywhere-on-firefox/main/updates.json",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
